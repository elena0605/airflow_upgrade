# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# --- Airflow / Docker ---
AIRFLOW_UID=501
AIRFLOW_ENV=development
# Use production on the hosted server: AIRFLOW_ENV=production

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# --- Local Mongo (docker-compose mongodb service) ---
MONGO_INITDB_ROOT_USERNAME=airflow
MONGO_INITDB_ROOT_PASSWORD=change-me

# --- Production Mongo (Cosmos DB / Atlas) — used when AIRFLOW_ENV=production ---
MONGODB_DB=rbl
MONGODB_URI=mongodb://user:password@host:10255/?ssl=true

# --- Neo4j (development: local compose or host.docker.internal) ---
NEO4J_URI_DEV=bolt://neo4j:7687
NEO4J_USER_DEV=neo4j
NEO4J_PASSWORD_DEV=change-me

# --- Neo4j (production) ---
NEO4J_URI=bolt+ssc://your-neo4j-host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- OpenAI / Azure OpenAI (analysis DAGs) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OUTPUT_MODE=chat

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_MODEL=gpt-4.1

AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_MODEL_NAME=text-embedding-3-large

# --- Optional: GitLab CI writes this file on the deploy host from CI/CD variables ---
# Platform API keys (YouTube / TikTok) are set in Airflow UI → Admin → Variables, not here.
